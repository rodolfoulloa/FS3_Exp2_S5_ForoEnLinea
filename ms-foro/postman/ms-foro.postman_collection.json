          "name": "2.3 GET /temas?categoriaId=2 - Filtrar por categoría",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Todos de Videojuegos', () => pm.response.json().forEach(t => pm.expect(t.categoriaId).to.eql(2)));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{foroUrl}}/temas?categoriaId=2"
          }
        },
        {
          "name": "2.4 GET /temas?estado=BANEADO - Sin ser ADMIN (403)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 403 Forbidden', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{foroUrl}}/temas?estado=BANEADO"
          }
        },
        {
          "name": "2.5 GET /temas?estado=BANEADO - Como ADMIN",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('Solo temas BANEADO', () => b.forEach(t => pm.expect(t.estado).to.eql('BANEADO')));",
                  "if (b.length) pm.collectionVariables.set('baneadoId', b[0].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Usuario-Id",
                "value": "{{adminId}}"
              }
            ],
            "url": "{{foroUrl}}/temas?estado=BANEADO"
          }
        },
        {
          "name": "2.6 GET /temas/1 - Ver un tema (suma una visita)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "const t = pm.response.json();",
                  "pm.test('Incluye autor, categoría y cantidad de comentarios', () => pm.expect(t).to.include.keys('autorAlias', 'categoria', 'comentarios', 'vistas'));",
                  "pm.collectionVariables.set('vistas', t.vistas);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{foroUrl}}/temas/1"
          }
        },
        {
          "name": "2.7 GET /temas/1 - Las visitas aumentan",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Vistas +1', () => pm.expect(pm.response.json().vistas).to.eql(Number(pm.collectionVariables.get('vistas')) + 1));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{foroUrl}}/temas/1"
          }
        },
        {
          "name": "2.8 GET /temas/{id} - Tema baneado (410)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 410 Gone', () => pm.response.to.have.status(410));",
                  "pm.test('Removido por moderación', () => pm.expect(pm.response.json().error).to.include('removido por moderación'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{foroUrl}}/temas/{{baneadoId}}"
          }
        },
        {
          "name": "2.9 GET /temas/abc - ID no numérico (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 400 Bad Request', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{foroUrl}}/temas/abc"
          }
        }
      ],
      "description": "Búsqueda por texto, categoría y estado, y visualización de temas."
    },
