{
  "info": {
    "name": "ms-foro - CRUD /temas",
    "description": "Colección generada por microservicio-arquetipo. Ejecutar en orden con 'Run collection'. Completa los bodies con los atributos reales de Tema.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8082" },
    { "key": "id", "value": "" }
  ],
  "item": [
    {
      "name": "1. GET - Listar",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
        "pm.test('Devuelve un arreglo', () => pm.expect(pm.response.json()).to.be.an('array'));"
      ] } }],
      "request": { "method": "GET", "url": "{{baseUrl}}/temas" }
    },
    {
      "name": "2. POST - Crear",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
        "pm.collectionVariables.set('id', pm.response.json().id);"
      ] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Ejemplo\"\n}" },
        "url": "{{baseUrl}}/temas"
      }
    },
    {
      "name": "3. GET - Obtener por ID",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status 200 OK', () => pm.response.to.have.status(200));"
      ] } }],
      "request": { "method": "GET", "url": "{{baseUrl}}/temas/{{id}}" }
    },
    {
      "name": "4. PUT - Actualizar",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status 200 OK', () => pm.response.to.have.status(200));"
      ] } }],
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Ejemplo actualizado\"\n}" },
        "url": "{{baseUrl}}/temas/{{id}}"
      }
    },
    {
      "name": "5. DELETE - Eliminar",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status 204 No Content', () => pm.response.to.have.status(204));"
      ] } }],
      "request": { "method": "DELETE", "url": "{{baseUrl}}/temas/{{id}}" }
    },
    {
      "name": "6. GET - Eliminado (404)",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status 404 Not Found', () => pm.response.to.have.status(404));"
      ] } }],
      "request": { "method": "GET", "url": "{{baseUrl}}/temas/{{id}}" }
    }
  ]
}
