                  "pm.test('Status 400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('Valida el motivo', () => pm.expect(pm.response.json().detalle.motivo).to.eql('El motivo debe tener entre 10 y 300 caracteres'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
