{
  "info": {
    "name": "Ágora · ms-moderacion",
    "description": "Microservicio de gestión de publicaciones y comentarios por un administrador (puerto 8083), contra Oracle Cloud.\n\nRequiere ms-usuarios (8081) y ms-foro (8082) en ejecución. Variables: autorId=4 (mati.gamer, publica el contenido), reportanteId=3 (vale.soto), otroReportanteId=5 (fer.cine), tercerReportanteId=6 (tomas.dev) y adminId=1 (camila.admin).\n\nURL base: variable {{moderacionUrl}}. Use el entorno 'Ágora · Local' o 'Ágora · Nube' (postman/ en la raíz del repositorio).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "moderacionUrl",
      "value": "http://localhost:8083"
    },
    {
      "key": "foroUrl",
      "value": "http://localhost:8082"
    },
    {
      "key": "adminId",
      "value": "1"
    },
    {
      "key": "autorId",
      "value": "4"
    },
    {
      "key": "reportanteId",
      "value": "3"
    },
    {
      "key": "otroReportanteId",
      "value": "5"
    },
    {
      "key": "tercerReportanteId",
      "value": "6"
    },
    {
      "key": "temaId",
      "value": ""
    },
    {
      "key": "comentarioId",
      "value": ""
    },
    {
      "key": "reporteId",
      "value": ""
    },
    {
      "key": "reporteComentarioId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Preparación en ms-foro",
      "item": [
        {
          "name": "1.1 POST {{foroUrl}}/temas - El autor publica un tema",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('temaId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Usuario-Id",
                "value": "{{autorId}}"
              }
            ],
            "url": "{{foroUrl}}/temas",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"OFERTA: compra seguidores baratos para tu canal\",\n  \"contenido\": \"Tema de prueba para moderación: simula publicidad no permitida en el foro de Ágora.\",\n  \"categoriaId\": 2\n}"
            }
          }
        },
        {
          "name": "1.2 POST {{foroUrl}}/temas/{id}/comentarios - El autor comenta",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('comentarioId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Usuario-Id",
                "value": "{{autorId}}"
              }
            ],
            "url": "{{foroUrl}}/temas/{{temaId}}/comentarios",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"contenido\": \"Comentario de prueba para moderación.\"\n}"
            }
          }
        }
      ],
      "description": "Crea un tema y un comentario en ms-foro para moderarlos (requiere ms-foro y ms-usuarios)."
    },
    {
      "name": "2. Reportes de usuarios",
      "item": [
        {
          "name": "2.1 POST /reportes - Datos vacíos (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('Valida tipo, contenido y motivo', () => pm.expect(pm.response.json().detalle).to.include.keys('tipoContenido', 'contenidoId', 'motivo'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Usuario-Id",
                "value": "{{reportanteId}}"
              }
            ],
            "url": "{{moderacionUrl}}/reportes",
            "body": {
              "mode": "raw",
              "raw": "{}"
            }
          }
        },
        {
          "name": "2.2 POST /reportes - Motivo OTRO sin detalle (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('Exige el detalle', () => pm.expect(pm.response.json().detalle.detalleSuficiente).to.exist);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Usuario-Id",
                "value": "{{reportanteId}}"
              }
            ],
            "url": "{{moderacionUrl}}/reportes",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipoContenido\": \"TEMA\",\n  \"contenidoId\": \"{{temaId}}\",\n  \"motivo\": \"OTRO\"\n}"
            }
          }
        },
        {
          "name": "2.3 POST /reportes - Tipo de contenido inválido (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 400 Bad Request', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Usuario-Id",
                "value": "{{reportanteId}}"
              }
            ],
            "url": "{{moderacionUrl}}/reportes",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipoContenido\": \"USUARIO\",\n  \"contenidoId\": 1,\n  \"motivo\": \"SPAM\"\n}"
            }
          }
        },
        {
          "name": "2.4 POST /reportes - Reportar contenido propio (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('No puede reportarse a sí mismo', () => pm.expect(pm.response.json().error).to.eql('No puede reportar su propio contenido'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Usuario-Id",
                "value": "{{autorId}}"
              }
            ],
            "url": "{{moderacionUrl}}/reportes",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipoContenido\": \"TEMA\",\n  \"contenidoId\": \"{{temaId}}\",\n  \"motivo\": \"SPAM\"\n}"
            }
          }
        },
        {
          "name": "2.5 POST /reportes - Contenido inexistente en ms-foro (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 404 Not Found', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Usuario-Id",
                "value": "{{reportanteId}}"
              }
            ],
            "url": "{{moderacionUrl}}/reportes",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipoContenido\": \"TEMA\",\n  \"contenidoId\": 999999,\n  \"motivo\": \"SPAM\"\n}"
            }
          }
        },
        {
          "name": "2.6 POST /reportes - Reportar un tema (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
                  "const r = pm.response.json();",
                  "pm.test('Queda PENDIENTE con el título del tema', () => { pm.expect(r.estado).to.eql('PENDIENTE'); pm.expect(r.resumenContenido).to.include('OFERTA'); });",
                  "pm.test('Reportante identificado en ms-usuarios', () => pm.expect(r.reportanteAlias).to.eql('vale.soto'));",
                  "pm.collectionVariables.set('reporteId', r.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Usuario-Id",
                "value": "{{reportanteId}}"
              }
            ],
            "url": "{{moderacionUrl}}/reportes",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipoContenido\": \"TEMA\",\n  \"contenidoId\": \"{{temaId}}\",\n  \"motivo\": \"SPAM\",\n  \"detalle\": \"Vende seguidores\"\n}"
            }
          }
        },
        {
          "name": "2.7 POST /reportes - El mismo usuario repite el reporte (409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 409 Conflict', () => pm.response.to.have.status(409));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Usuario-Id",
                "value": "{{reportanteId}}"
              }
            ],
            "url": "{{moderacionUrl}}/reportes",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipoContenido\": \"TEMA\",\n  \"contenidoId\": \"{{temaId}}\",\n  \"motivo\": \"SPAM\"\n}"
            }
          }
        },
        {
          "name": "2.8 POST /reportes - Otro usuario reporta el mismo tema",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201 Created', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Usuario-Id",
                "value": "{{otroReportanteId}}"
              }
            ],
            "url": "{{moderacionUrl}}/reportes",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipoContenido\": \"TEMA\",\n  \"contenidoId\": \"{{temaId}}\",\n  \"motivo\": \"CONTENIDO_INAPROPIADO\"\n}"
            }
          }
        },
        {
          "name": "2.9 POST /reportes - Reportar un comentario",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('reporteComentarioId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Usuario-Id",
                "value": "{{reportanteId}}"
              }
            ],
            "url": "{{moderacionUrl}}/reportes",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipoContenido\": \"COMENTARIO\",\n  \"contenidoId\": \"{{comentarioId}}\",\n  \"motivo\": \"OTRO\",\n  \"detalle\": \"Parece un comentario automático sin relación con el tema\"\n}"
            }
          }
        },
        {
          "name": "2.10 GET /reportes - Como USUARIO (403)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 403 Forbidden', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Usuario-Id",
                "value": "{{reportanteId}}"
              }
            ],
            "url": "{{moderacionUrl}}/reportes"
          }
        },
        {
          "name": "2.11 GET /reportes?estado=PENDIENTE - Bandeja del ADMIN",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "const ids = pm.response.json().map(r => r.id);",
                  "pm.test('Incluye los reportes nuevos', () => pm.expect(ids).to.include(Number(pm.collectionVariables.get('reporteId'))));",
                  "pm.test('Solo PENDIENTE', () => pm.response.json().forEach(r => pm.expect(r.estado).to.eql('PENDIENTE')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Usuario-Id",
                "value": "{{adminId}}"
              }
            ],
            "url": "{{moderacionUrl}}/reportes?estado=PENDIENTE"
          }
        }
      ],
      "description": "Cualquier usuario activo reporta contenido; solo el ADMIN ve la bandeja."
    },
    {
      "name": "3. Moderación por el ADMIN",
      "item": [
        {
          "name": "3.1 POST /moderacion/temas/{id}/banear - Como USUARIO (403)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 403 Forbidden', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Usuario-Id",
                "value": "{{reportanteId}}"
              }
            ],
            "url": "{{moderacionUrl}}/moderacion/temas/{{temaId}}/banear",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"motivo\": \"Intento sin permisos de administrador\"\n}"
            }
          }
        },
        {
          "name": "3.2 POST /moderacion/temas/{id}/banear - Motivo muy corto (400)",
          "event": [
