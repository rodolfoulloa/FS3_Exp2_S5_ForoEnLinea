{
  "info": {
    "name": "Ágora · ms-usuarios",
    "description": "Microservicio de control de usuarios e inicio de sesión (puerto 8081), contra Oracle Cloud.\n\nEjecutar en orden con 'Run collection'. Usuarios de prueba: camila.admin / Admin#2025 (ADMIN) y vale.soto / Foro#2025 (USUARIO). Las operaciones protegidas usan el header X-Usuario-Id.\n\nURL base: variable {{usuariosUrl}}. Use el entorno 'Ágora · Local' o 'Ágora · Nube' (postman/ en la raíz del repositorio).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "usuariosUrl",
      "value": "http://localhost:8081"
    },
    {
      "key": "sufijo",
      "value": ""
    },
    {
      "key": "adminId",
      "value": ""
    },
    {
      "key": "usuarioId",
      "value": ""
    },
    {
      "key": "creadoId",
      "value": ""
    },
    {
      "key": "codigo",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Autenticación y registro",
      "item": [
        {
          "name": "1.1 POST /auth/login - Admin (camila.admin)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Sufijo único para que la colección se pueda ejecutar muchas veces",
                  "pm.collectionVariables.set('sufijo', String(Date.now()).slice(-7));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test('Rol ADMIN', () => pm.expect(r.usuario.rol).to.eql('ADMIN'));",
                  "pm.test('No expone la contraseña', () => pm.expect(r.usuario).to.not.have.property('passwordHash'));",
                  "pm.collectionVariables.set('adminId', r.usuario.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{usuariosUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario\": \"camila.admin\",\n  \"password\": \"Admin#2025\"\n}"
            }
          }
        },
        {
          "name": "1.2 POST /auth/login - Contraseña incorrecta (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 401 Unauthorized', () => pm.response.to.have.status(401));",
                  "pm.test('Mensaje genérico', () => pm.expect(pm.response.json().error).to.eql('Usuario o contraseña incorrectos'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{usuariosUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario\": \"camila.admin\",\n  \"password\": \"Incorrecta#1\"\n}"
            }
          }
        },
        {
          "name": "1.3 POST /auth/registro - Contraseña insegura (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('Indica la regla incumplida', () => pm.expect(pm.response.json().detalle.password).to.eql('La contraseña debe incluir al menos un carácter especial (ej: ! @ # $ % & *)'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{usuariosUrl}}/auth/registro",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Usuario Prueba\",\n  \"alias\": \"qa{{sufijo}}\",\n  \"email\": \"qa{{sufijo}}@correo.cl\",\n  \"password\": \"Clave2025\",\n  \"confirmacion\": \"Clave2025\",\n  \"aceptaNormas\": true\n}"
            }
          }
        },
        {
          "name": "1.4 POST /auth/registro - Campos inválidos (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 400 Bad Request', () => pm.response.to.have.status(400));",
                  "const d = pm.response.json().detalle;",
                  "pm.test('Valida nombre, alias, email, confirmación y normas', () => pm.expect(d).to.include.keys('nombre', 'alias', 'email', 'confirmacionValida', 'aceptaNormas'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{usuariosUrl}}/auth/registro",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"N4\",\n  \"alias\": \"a b\",\n  \"email\": \"no-es-email\",\n  \"password\": \"Clave#2025\",\n  \"confirmacion\": \"Otra#2025\",\n  \"aceptaNormas\": false\n}"
            }
          }
        },
        {
          "name": "1.5 POST /auth/registro - Registro exitoso (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
                  "const u = pm.response.json();",
                  "pm.test('Queda con rol USUARIO y activo', () => { pm.expect(u.rol).to.eql('USUARIO'); pm.expect(u.activo).to.eql(true); });",
                  "pm.collectionVariables.set('usuarioId', u.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{usuariosUrl}}/auth/registro",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Usuario Prueba\",\n  \"alias\": \"qa{{sufijo}}\",\n  \"email\": \"qa{{sufijo}}@correo.cl\",\n  \"password\": \"Prueba#2025\",\n  \"confirmacion\": \"Prueba#2025\",\n  \"aceptaNormas\": true\n}"
            }
          }
        },
        {
          "name": "1.6 POST /auth/registro - Email repetido (409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 409 Conflict', () => pm.response.to.have.status(409));",
                  "pm.test('Informa el email repetido', () => pm.expect(pm.response.json().error).to.include('ya está registrado'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{usuariosUrl}}/auth/registro",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Usuario Prueba\",\n  \"alias\": \"qb{{sufijo}}\",\n  \"email\": \"qa{{sufijo}}@correo.cl\",\n  \"password\": \"Prueba#2025\",\n  \"confirmacion\": \"Prueba#2025\",\n  \"aceptaNormas\": true\n}"
            }
          }
        },
        {
          "name": "1.7 POST /auth/login - Usuario nuevo con su alias",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Es el usuario registrado', () => pm.expect(pm.response.json().usuario.id).to.eql(Number(pm.collectionVariables.get('usuarioId'))));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{usuariosUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario\": \"qa{{sufijo}}\",\n  \"password\": \"Prueba#2025\"\n}"
            }
          }
        },
        {
          "name": "1.8 POST /auth/recuperar - Solicitar código",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test('Código simulado de 6 dígitos', () => pm.expect(r.codigoSimulado).to.match(/^\\d{6}$/));",
                  "pm.collectionVariables.set('codigo', r.codigoSimulado);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{usuariosUrl}}/auth/recuperar",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"qa{{sufijo}}@correo.cl\"\n}"
            }
          }
        },
        {
          "name": "1.9 POST /auth/restablecer - Código incorrecto (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('Código no válido', () => pm.expect(pm.response.json().error).to.eql('El código no es válido o ya expiró'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{usuariosUrl}}/auth/restablecer",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"qa{{sufijo}}@correo.cl\",\n  \"codigo\": \"000000\",\n  \"nuevaPassword\": \"Nueva#2025\",\n  \"confirmacion\": \"Nueva#2025\"\n}"
            }
          }
        },
        {
          "name": "1.10 POST /auth/restablecer - Nueva contraseña",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{usuariosUrl}}/auth/restablecer",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"qa{{sufijo}}@correo.cl\",\n  \"codigo\": \"{{codigo}}\",\n  \"nuevaPassword\": \"Nueva#2025\",\n  \"confirmacion\": \"Nueva#2025\"\n}"
            }
          }
        },
        {
          "name": "1.11 POST /auth/login - Con la contraseña restablecida",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{usuariosUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario\": \"qa{{sufijo}}@correo.cl\",\n  \"password\": \"Nueva#2025\"\n}"
            }
          }
        }
      ],
      "description": "Inicio de sesión, registro con validaciones y recuperación de contraseña en 2 pasos."
    },
    {
      "name": "2. Perfil (rol USUARIO)",
      "item": [
        {
          "name": "2.1 GET /usuarios/{id} - Ver perfil",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Devuelve el alias', () => pm.expect(pm.response.json().alias).to.eql('qa' + pm.collectionVariables.get('sufijo')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{usuariosUrl}}/usuarios/{{usuarioId}}"
          }
        },
        {
          "name": "2.2 PUT /usuarios/{id} - Modificar perfil propio",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Biografía actualizada', () => pm.expect(pm.response.json().biografia).to.eql('Me gustan los foros de tecnología.'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Usuario-Id",
                "value": "{{usuarioId}}"
              }
            ],
            "url": "{{usuariosUrl}}/usuarios/{{usuarioId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Usuario Prueba Editado\",\n  \"alias\": \"qa{{sufijo}}\",\n  \"email\": \"qa{{sufijo}}@correo.cl\",\n  \"biografia\": \"Me gustan los foros de tecnología.\"\n}"
            }
          }
        },
        {
          "name": "2.3 PUT /usuarios/{id} - Datos inválidos (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('Valida el email', () => pm.expect(pm.response.json().detalle.email).to.eql('El email no tiene un formato válido'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Usuario-Id",
                "value": "{{usuarioId}}"
              }
            ],
            "url": "{{usuariosUrl}}/usuarios/{{usuarioId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Usuario Prueba\",\n  \"alias\": \"qa{{sufijo}}\",\n  \"email\": \"correo-invalido\"\n}"
            }
          }
        },
        {
          "name": "2.4 PUT /usuarios/{id} - Perfil de otro usuario (403)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 403 Forbidden', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Usuario-Id",
                "value": "{{usuarioId}}"
              }
            ],
            "url": "{{usuariosUrl}}/usuarios/{{adminId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Camila Rojas\",\n  \"alias\": \"camila.admin\",\n  \"email\": \"camila@agora.cl\"\n}"
            }
          }
        },
        {
          "name": "2.5 PUT /usuarios/{id}/password - Contraseña actual incorrecta (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 401 Unauthorized', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Usuario-Id",
                "value": "{{usuarioId}}"
              }
            ],
            "url": "{{usuariosUrl}}/usuarios/{{usuarioId}}/password",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"actual\": \"Mala#2025\",\n  \"nueva\": \"Otra#2025\",\n  \"confirmacion\": \"Otra#2025\"\n}"
            }
          }
        },
        {
          "name": "2.6 PUT /usuarios/{id}/password - Cambiar contraseña",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Usuario-Id",
                "value": "{{usuarioId}}"
              }
            ],
            "url": "{{usuariosUrl}}/usuarios/{{usuarioId}}/password",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"actual\": \"Nueva#2025\",\n  \"nueva\": \"Cambiada#2025\",\n  \"confirmacion\": \"Cambiada#2025\"\n}"
            }
          }
        },
        {
          "name": "2.7 GET /usuarios - Listar como USUARIO (403)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 403 Forbidden', () => pm.response.to.have.status(403));",
                  "pm.test('Requiere ADMIN', () => pm.expect(pm.response.json().error).to.eql('Esta operación requiere el rol ADMIN'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Usuario-Id",
                "value": "{{usuarioId}}"
              }
            ],
            "url": "{{usuariosUrl}}/usuarios"
          }
        }
      ],
      "description": "Lo que puede hacer un usuario con rol USUARIO sobre su propia cuenta, y lo que no."
    },
    {
      "name": "3. Administración (rol ADMIN)",
      "item": [
        {
          "name": "3.1 GET /usuarios - Listar todos",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Hay usuarios de ambos roles', () => { const roles = pm.response.json().map(u => u.rol); pm.expect(roles).to.include('ADMIN'); pm.expect(roles).to.include('USUARIO'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Usuario-Id",
                "value": "{{adminId}}"
              }
            ],
            "url": "{{usuariosUrl}}/usuarios"
          }
        },
        {
          "name": "3.2 GET /usuarios?rol=ADMIN - Filtrar por rol",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Solo administradores', () => pm.response.json().forEach(u => pm.expect(u.rol).to.eql('ADMIN')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Usuario-Id",
                "value": "{{adminId}}"
              }
            ],
            "url": "{{usuariosUrl}}/usuarios?rol=ADMIN"
          }
        },
        {
          "name": "3.3 GET /usuarios?q=qa - Buscar por texto",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Encuentra al usuario de prueba', () => pm.expect(pm.response.json().length).to.eql(1));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Usuario-Id",
                "value": "{{adminId}}"
              }
            ],
            "url": "{{usuariosUrl}}/usuarios?q=qa{{sufijo}}"
          }
        },
        {
          "name": "3.4 GET /usuarios - Sin header X-Usuario-Id (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 400 Bad Request', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{usuariosUrl}}/usuarios"
          }
        },
        {
          "name": "3.5 POST /usuarios - Admin crea un usuario ADMIN",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('Rol ADMIN', () => pm.expect(pm.response.json().rol).to.eql('ADMIN'));",
                  "pm.collectionVariables.set('creadoId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Usuario-Id",
                "value": "{{adminId}}"
              }
            ],
            "url": "{{usuariosUrl}}/usuarios",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Moderador Prueba\",\n  \"alias\": \"mod{{sufijo}}\",\n  \"email\": \"mod{{sufijo}}@agora.cl\",\n  \"password\": \"Moderar#2025\",\n  \"rol\": \"ADMIN\"\n}"
            }
          }
        },
        {
          "name": "3.6 POST /usuarios - Como USUARIO (403)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 403 Forbidden', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Usuario-Id",
                "value": "{{usuarioId}}"
              }
            ],
            "url": "{{usuariosUrl}}/usuarios",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Intruso\",\n  \"alias\": \"intruso{{sufijo}}\",\n  \"email\": \"intruso{{sufijo}}@correo.cl\",\n  \"password\": \"Intruso#2025\",\n  \"rol\": \"ADMIN\"\n}"
            }
          }
        },
        {
          "name": "3.7 PATCH /usuarios/{id}/rol - Cambiar a USUARIO",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Rol cambiado', () => pm.expect(pm.response.json().rol).to.eql('USUARIO'));"
                ]
